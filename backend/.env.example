OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=./data/chroma
SQLITE_PATH=./data/metadata.sqlite3
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver


# Explicit offline demonstration, never real OpenAI quality scores
CITERAG_DEMO=false

# Dense remains available as the original baseline. Threshold is calibrated only
# on the bundled sample corpus; recalibrate on held-out data for other corpora.
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.2
RERANKER=lightweight
# Optional: cross_encoder, with a pre-provisioned local model and separate tuning.
RERANKER_MODEL=
MAX_KEYWORD_CHUNKS=50000

OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_PDF_PAGES=200
MAX_CHUNKS_PER_UPLOAD=500
MAX_EXTRACTED_CHARS=2000000
METRICS_RETENTION_DAYS=30
LOG_QUERY_TEXT=false
# Optional durable paths; defaults point to backend/evals locally.
# EVALUATION_PATH=./data/evaluations/latest.json
# EVALUATION_HISTORY_PATH=./data/evaluations/runs

# Optional user-supplied USD prices per million tokens. Blank means unknown.
# Match these to your configured models and current provider billing terms.
CHAT_INPUT_USD_PER_MILLION=
CHAT_OUTPUT_USD_PER_MILLION=
EMBEDDING_USD_PER_MILLION=
